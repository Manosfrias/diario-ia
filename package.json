{
  "name": "diario-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Diario personal que transforma dictados en bruto en relatos coherentes con IA.",
  "type": "module",
  "workspaces": [
    "apps/backend",
    "apps/frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n back,front -c blue,magenta \"npm run dev -w apps/backend\" \"npm run dev -w apps/frontend\"",
    "start": "npm run start -w apps/backend",
    "build": "npm run build -w apps/frontend",
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3"
  }
}
